{
  "manifest_version": "0.3",
  "name": "shapeforge",
  "display_name": "shapeforge - 3D modeling",
  "version": "0.0.0-dev",
  "description": "Build, render, measure and export 3D models (OBJ) from a conversation.",
  "long_description": "shapeforge gives Claude a 3D modeling toolkit designed for AI: parametric parts (boxes, cylinders, lathe and extrude profiles, CSG booleans), rendered multi-view images so Claude can see what it built, exact measurements, placement helpers (place on, mirror, array, align) and Wavefront OBJ export. Runs locally as a single native binary.",
  "author": {
    "name": "rashid5925"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rashid5925/3d-model-generator.git"
  },
  "homepage": "https://github.com/rashid5925/3d-model-generator",
  "support": "https://github.com/rashid5925/3d-model-generator/issues",
  "icon": "icon.png",
  "license": "MIT",
  "keywords": ["3d", "modeling", "obj", "cad", "render"],
  "server": {
    "type": "binary",
    "entry_point": "server/shapeforge-macos",
    "mcp_config": {
      "command": "${__dirname}/server/shapeforge-macos",
      "args": ["mcp", "--workdir", "${user_config.output_directory}"],
      "env": {},
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/shapeforge-windows.exe"
        },
        "linux": {
          "command": "${__dirname}/server/shapeforge-linux-x64"
        }
      }
    }
  },
  "tools": [
    {"name": "add_objects", "description": "Add or replace parametric parts"},
    {"name": "update_objects", "description": "Edit parts with merge patches"},
    {"name": "delete_objects", "description": "Delete parts"},
    {"name": "get_scene", "description": "Show the scene hierarchy and specs"},
    {"name": "clear_scene", "description": "Remove every part"},
    {"name": "render", "description": "Render multi-view images of the model"},
    {"name": "place_on", "description": "Rest a part on another part or the ground"},
    {"name": "align_objects", "description": "Align parts on an axis"},
    {"name": "mirror_object", "description": "Mirrored copy of a part"},
    {"name": "array_object", "description": "Linear or radial copies"},
    {"name": "inspect", "description": "Exact measurements and contact checks"},
    {"name": "export_obj", "description": "Export Wavefront OBJ + MTL"},
    {"name": "save_scene", "description": "Save the editable scene"},
    {"name": "load_scene", "description": "Load a saved scene"},
    {"name": "undo", "description": "Revert recent changes"}
  ],
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  },
  "user_config": {
    "output_directory": {
      "type": "directory",
      "title": "Output folder",
      "description": "Where exported models, renders and saved scenes are written",
      "default": "${DOCUMENTS}/shapeforge",
      "required": true
    }
  }
}
